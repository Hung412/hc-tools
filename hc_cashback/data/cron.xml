<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_sync_conversions" model="ir.cron">
            <field name="name">Cashback: sync affiliate conversions</field>
            <field name="model_id" ref="model_hc_cashback_provider"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_conversions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.today() + timedelta(days=1)).strftime('%Y-%m-%d 03:30:00')"/>
        </record>

        <record id="cron_refresh_zalo_token" model="ir.cron">
            <field name="name">Cashback: refresh Zalo access token</field>
            <field name="model_id" ref="model_hc_cashback_zalo"/>
            <field name="state">code</field>
            <field name="code">model.cron_refresh_access_token()</field>
            <field name="interval_number">45</field>
            <field name="interval_type">minutes</field>
        </record>

    </data>
</odoo>
