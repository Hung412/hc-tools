<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hc_cashback_import_wizard_view_form" model="ir.ui.view">
        <field name="name">hc.cashback.import.wizard.view.form</field>
        <field name="model">hc.cashback.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Conversion Report">
                <group>
                    <field name="provider_id"/>
                    <field name="report_file" filename="report_filename"/>
                    <field name="report_filename" invisible="1"/>
                </group>
                <p class="text-muted">
                    Export the conversion report from the affiliate dashboard with every
                    column enabled, including Sub_id1 to Sub_id5. Importing the same file
                    twice is safe: existing order lines are updated, never duplicated.
                </p>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="hc_cashback_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Import Conversion Report</field>
        <field name="res_model">hc.cashback.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
