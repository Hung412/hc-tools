<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hc_cashback_commission_rule_view_list" model="ir.ui.view">
        <field name="name">hc.cashback.commission.rule.view.list</field>
        <field name="model">hc.cashback.commission.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="tax_rate" widget="percentage"/>
                <field name="member_share" widget="percentage"/>
                <field name="platform_share" widget="percentage"/>
            </list>
        </field>
    </record>

    <record id="hc_cashback_commission_rule_view_form" model="ir.ui.view">
        <field name="name">hc.cashback.commission.rule.view.form</field>
        <field name="model">hc.cashback.commission.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Default 90/10"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="tax_rate" widget="percentage"/>
                            <field name="member_share" widget="percentage"/>
                            <field name="platform_share" widget="percentage"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hc_cashback_commission_rule_action" model="ir.actions.act_window">
        <field name="name">Commission Rules</field>
        <field name="res_model">hc.cashback.commission.rule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
