<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hc_cashback_link_view_list" model="ir.ui.view">
        <field name="name">hc.cashback.link.view.list</field>
        <field name="model">hc.cashback.link</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'">
                <field name="create_date"/>
                <field name="member_id"/>
                <field name="provider_id" optional="show"/>
                <field name="clean_url"/>
                <field name="tracking_url" optional="show"/>
                <field name="request_key" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="hc_cashback_link_view_form" model="ir.ui.view">
        <field name="name">hc.cashback.link.view.form</field>
        <field name="model">hc.cashback.link</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="provider_id"/>
                            <field name="request_key"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="shop_reference"/>
                            <field name="item_reference"/>
                        </group>
                    </group>
                    <group>
                        <field name="origin_url"/>
                        <field name="clean_url"/>
                        <field name="tracking_url" widget="url"/>
                        <field name="error_message" invisible="state != 'failed'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hc_cashback_link_action" model="ir.actions.act_window">
        <field name="name">Tracking Links</field>
        <field name="res_model">hc.cashback.link</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
