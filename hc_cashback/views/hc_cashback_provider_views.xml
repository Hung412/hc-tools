<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hc_cashback_provider_view_list" model="ir.ui.view">
        <field name="name">hc.cashback.provider.view.list</field>
        <field name="model">hc.cashback.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="key"/>
                <field name="is_default"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <record id="hc_cashback_provider_view_form" model="ir.ui.view">
        <field name="name">hc.cashback.provider.view.form</field>
        <field name="model">hc.cashback.provider</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="sync_conversions" type="object" string="Sync Now" class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Shopee Affiliate"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="key"/>
                            <field name="is_default"/>
                            <field name="link_template" placeholder="https://shopee.vn/?mmp_pid=an_1&amp;utm_content={sub_ids}"/>
                            <field name="endpoint_url" invisible="key != 'shopee_direct'"/>
                            <field name="request_timeout"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="app_id" password="True" invisible="key != 'shopee_direct'"/>
                            <field name="app_secret" password="True" invisible="key != 'shopee_direct'"/>
                            <field name="sync_from_date"/>
                            <field name="sync_overlap_days"/>
                            <field name="last_sync_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hc_cashback_provider_action" model="ir.actions.act_window">
        <field name="name">Affiliate Providers</field>
        <field name="res_model">hc.cashback.provider</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
