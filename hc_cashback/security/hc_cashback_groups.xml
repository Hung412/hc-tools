<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_cashback" model="ir.module.category">
        <field name="name">Cashback</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_cashback_user" model="res.groups">
        <field name="name">Agent</field>
        <field name="category_id" ref="module_category_cashback"/>
    </record>

    <record id="group_cashback_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_cashback"/>
        <field name="implied_ids" eval="[(4, ref('group_cashback_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
