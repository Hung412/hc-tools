<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Example OpenRouter Configuration (to be updated by user) -->
        <record id="openrouter_config_default" model="openrouter.config">
            <field name="name">Default OpenRouter Configuration</field>
            <field name="api_key">YOUR_API_KEY_HERE</field>
            <field name="model">gpt-oss-20b</field>
            <field name="max_tokens">1000</field>
            <field name="temperature">0.7</field>
            <field name="system_prompt">You are a helpful AI assistant integrated into Odoo ERP system. You can help users with questions about their business data, processes, and general queries. Be concise and professional.</field>
            <field name="active" eval="False"/>
        </record>
        
    </data>
</odoo>

