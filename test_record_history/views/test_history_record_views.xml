<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="test_history_record_view_form" model="ir.ui.view">
        <field name="name">test.history.record.view.form</field>
        <field name="model">test.history.record</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="state"/>
                        <field name="partner_id"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                        <field name="amount"/>
                        <field name="amount_doubled"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
