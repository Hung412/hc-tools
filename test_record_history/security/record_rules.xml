<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="test_history_record_own" model="ir.rule">
            <field name="name">Test History Record: own records</field>
            <field name="model_id" ref="model_test_history_record"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="test_history_record_system" model="ir.rule">
            <field name="name">Test History Record: all records</field>
            <field name="model_id" ref="model_test_history_record"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
