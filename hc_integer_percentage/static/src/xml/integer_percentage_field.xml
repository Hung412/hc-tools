<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hc_integer_percentage.IntegerPercentageField">
        <t t-if="props.readonly">
            <span t-esc="formattedValue"/>
        </t>
        <t t-else="">
            <div class="d-flex">
                <input
                    t-ref="input"
                    class="o_input"
                    t-att-placeholder="props.placeholder"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                />
                <span>%</span>
            </div>
        </t>
    </t>

</templates>
